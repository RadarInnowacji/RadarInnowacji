# ===== Radar Innowacji – konfiguracja =====
SITE_NAME=Radar Innowacji
BASE_URL=https://radarinnowacji.pl

# Klucze bezpieczeństwa – wygeneruj: php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=
HASH_PEPPER=

# Twój e-mail (po zalogowaniu nim zobaczysz Panel). Kilka adresów po przecinku.
ADMIN_EMAILS=twoj@email.pl

# Nadawca maili z linkami logowania (załóż tę skrzynkę w panelu nazwa.pl)
SMTP_FROM=Radar Innowacji <no-reply@radarinnowacji.pl>
# Zostaw SMTP_HOST pusty, żeby użyć wbudowanej poczty serwera (zalecane na nazwa.pl).
# Jeśli maile nie dochodzą, uzupełnij dane skrzynki:
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=no-reply@radarinnowacji.pl
SMTP_PASSWORD=

# Wyniki: always = liczniki widoczne cały czas, after_end = po zakończeniu głosowania
SHOW_RESULTS=always
VOTES_PER_USER=3

# Harmonogram (puste = bez ograniczeń), np. 2026-12-31T23:59:00+01:00
SUBMISSIONS_END=
VOTING_START=
VOTING_END=

# Opcjonalnie: tylko adresy z tych domen mogą się logować, np. edu.pl,gov.pl
ALLOWED_EMAIL_DOMAINS=

# Cloudflare Turnstile (opcjonalnie)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Zaawansowane
POW_DIFFICULTY=18
POW_DIFFICULTY_SUSPICIOUS=21
RISK_THRESHOLD=50
MAX_ACCOUNTS_PER_SUBNET_DAY=60
DEBUG=false
